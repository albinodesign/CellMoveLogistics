---
const currentYear = new Date().getFullYear();
---

<footer class="bg-dark-800 border-t border-dark-700 mt-auto" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Logo & Description -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center mb-4" aria-label="CellMove Logistics - Zur Startseite">
          <img 
            src="/images/cellmove_logo.svg" 
            alt="CellMove Logistics Logo" 
            class="h-8 w-auto"
            width="144"
            height="32"
          />
        </a>
        <p class="text-gray-400 text-sm leading-relaxed">
          Ihr Spezialist für sicheren Gefahrguttransport von Lithium-Ionen Batterien, Zellen und Modulen in ganz Europa.
        </p>
        <div class="mt-4 flex gap-4">
          <a 
            href="tel:+4915560114442" 
            class="text-gray-400 hover:text-brand transition-colors"
            aria-label="Telefon"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </a>
          <a 
            href="mailto:contact@cellmove-logistics.com" 
            class="text-gray-400 hover:text-brand transition-colors"
            aria-label="E-Mail"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Navigation -->
      <div>
        <h3 class="text-white font-semibold mb-4">Navigation</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-gray-400 hover:text-brand transition-colors text-sm">Startseite</a></li>
          <li><a href="/services" class="text-gray-400 hover:text-brand transition-colors text-sm">Leistungen</a></li>
          <li><a href="/contact" class="text-gray-400 hover:text-brand transition-colors text-sm">Kontakt</a></li>
          <li><a href="/legal" class="text-gray-400 hover:text-brand transition-colors text-sm">Impressum & Datenschutz</a></li>
        </ul>
      </div>
      
      <!-- Services -->
      <div>
        <h3 class="text-white font-semibold mb-4">Leistungen</h3>
        <ul class="space-y-2">
          <li><span class="text-gray-400 text-sm">Zelltransporte (UN3480/UN3481)</span></li>
          <li><span class="text-gray-400 text-sm">Modultransporte</span></li>
          <li><span class="text-gray-400 text-sm">Batterietransporte (Hochvolt)</span></li>
          <li><span class="text-gray-400 text-sm">ADR-konforme Logistik</span></li>
          <li><span class="text-gray-400 text-sm">Europaweite Distribution</span></li>
        </ul>
      </div>
      
      <!-- Contact Info -->
      <div>
        <h3 class="text-white font-semibold mb-4">Kontakt</h3>
        <address class="not-italic space-y-2 text-sm">
          <p class="text-gray-400">
            <strong class="text-white block">CellMove Logistics GmbH</strong>
            Peter-Rosegger-Str. 4<br/>
            72762 Reutlingen<br/>
            Deutschland
          </p>
          <p class="text-gray-400">
            <a href="tel:+4915560114442" class="hover:text-brand transition-colors">Tel: +49 155 60 11 44 42</a><br/>
            <a href="mailto:contact@cellmove-logistics.com" class="hover:text-brand transition-colors">contact@cellmove-logistics.com</a>
          </p>
        </address>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-dark-700 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-gray-500 text-sm">
        © {currentYear} CellMove Logistics GmbH. Alle Rechte vorbehalten.
      </p>
      <div class="flex items-center gap-6">
        <a href="/legal#impressum" class="text-gray-500 hover:text-brand transition-colors text-sm">Impressum</a>
        <a href="/legal#datenschutz" class="text-gray-500 hover:text-brand transition-colors text-sm">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
