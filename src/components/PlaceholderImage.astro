---
export interface Props {
  width?: string;
  height?: string;
  alt: string;
  class?: string;
  aspectRatio?: string;
  lazy?: boolean;
}

const { 
  width = '100%', 
  height, 
  alt, 
  class: className = '',
  aspectRatio = '16/9',
  lazy = true
} = Astro.props;

// Generate a subtle gradient based on alt text (deterministic)
const hash = alt.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
const hue1 = (hash * 137) % 360;
const hue2 = (hue1 + 30) % 360;
const gradient = `linear-gradient(135deg, hsl(${hue1}, 20%, 20%) 0%, hsl(${hue2}, 20%, 15%) 100%)`;
---

<div 
  class={`relative bg-dark-800 overflow-hidden ${className}`}
  style={`
    width: ${width}; 
    ${height ? `height: ${height};` : ''}
    aspect-ratio: ${aspectRatio};
    background: ${gradient};
  `}
  role="img"
  aria-label={alt}
>
  <!-- Placeholder Icon -->
  <div class="absolute inset-0 flex items-center justify-center">
    <svg 
      class="w-1/4 h-1/4 text-gray-600 opacity-50" 
      fill="none" 
      stroke="currentColor" 
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path 
        stroke-linecap="round" 
        stroke-linejoin="round" 
        stroke-width="1" 
        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
      />
    </svg>
  </div>
  
  <!-- Alt text overlay (visible on hover/focus for debugging) -->
  <div class="absolute inset-0 bg-dark-900/80 opacity-0 hover:opacity-100 focus-within:opacity-100 transition-opacity flex items-center justify-center p-4">
    <span class="text-gray-300 text-xs text-center">{alt}</span>
  </div>
</div>

<!-- 
  Usage instructions for real images:
  
  For WebP/AVIF with lazy loading, replace this component with:
  
  <picture>
    <source srcset="/images/image.avif" type="image/avif" />
    <source srcset="/images/image.webp" type="image/webp" />
    <img 
      src="/images/image.jpg" 
      alt="..."
      loading="lazy"
      decoding="async"
      width="..."
      height="..."
    />
  </picture>
-->
