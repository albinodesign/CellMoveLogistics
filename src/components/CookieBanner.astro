---
---

<div 
  id="cookie-banner" 
  class="fixed bottom-0 left-0 right-0 z-50 bg-dark-800 border-t border-dark-700 shadow-2xl transform translate-y-full transition-transform duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-description"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <!-- Text Content -->
      <div class="flex-1">
        <h2 id="cookie-title" class="text-white font-semibold text-lg mb-2">
          Datenschutzeinstellungen
        </h2>
        <p id="cookie-description" class="text-gray-400 text-sm leading-relaxed max-w-3xl">
          Wir verwenden ausschließlich technisch notwendige Cookies, um diese Website funktionsfähig zu machen. 
          Externe Dienste wie Analytics oder Tracking werden ohne Ihre ausdrückliche Zustimmung nicht geladen. 
          Weitere Informationen finden Sie in unserer <a href="/legal#datenschutz" class="text-brand hover:underline">Datenschutzerklärung</a>.
        </p>
      </div>
      
      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <button 
          type="button"
          id="cookie-essential"
          class="px-5 py-2.5 border border-dark-600 text-gray-300 rounded-lg hover:bg-dark-700 transition-colors text-sm font-medium"
        >
          Nur Essentiell
        </button>
        <button 
          type="button"
          id="cookie-decline"
          class="px-5 py-2.5 border border-dark-600 text-gray-300 rounded-lg hover:bg-dark-700 transition-colors text-sm font-medium"
        >
          Ablehnen
        </button>
        <button 
          type="button"
          id="cookie-accept"
          class="px-5 py-2.5 bg-brand hover:bg-brand-dark text-dark-900 rounded-lg transition-colors text-sm font-semibold"
        >
          Zustimmen
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const COOKIE_CONSENT_KEY = 'cellmove_cookie_consent';
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const declineBtn = document.getElementById('cookie-decline');
    const essentialBtn = document.getElementById('cookie-essential');
    
    // Check if consent already given
    const consent = localStorage.getItem(COOKIE_CONSENT_KEY);
    
    function showBanner() {
      if (banner) {
        banner.classList.remove('translate-y-full');
      }
    }
    
    function hideBanner() {
      if (banner) {
        banner.classList.add('translate-y-full');
      }
    }
    
    function setConsent(choice: 'accepted' | 'declined' | 'essential') {
      localStorage.setItem(COOKIE_CONSENT_KEY, choice);
      hideBanner();
      
      // Dispatch custom event for other scripts
      window.dispatchEvent(new CustomEvent('cookieConsentChanged', { 
        detail: { choice } 
      }));
      
      // If analytics should be loaded only on accept
      if (choice === 'accepted') {
        // Analytics initialization would go here
        console.log('Analytics enabled');
      }
    }
    
    // Show banner if no consent yet
    if (!consent) {
      // Small delay for better UX
      setTimeout(showBanner, 1000);
    }
    
    // Button handlers
    acceptBtn?.addEventListener('click', () => setConsent('accepted'));
    declineBtn?.addEventListener('click', () => setConsent('declined'));
    essentialBtn?.addEventListener('click', () => setConsent('essential'));
    
    // Handle Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !banner?.classList.contains('translate-y-full')) {
        setConsent('essential');
      }
    });
  })();
</script>
