---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';


const pageTitle = "Leistungen | CellMove Logistics - Gefahrguttransport Spezialist";
const pageDescription = "Professionelle Transportlösungen für Lithium-Ionen Batterien, Zellen und Module. ADR-konform, UN3480/UN3481 zertifiziert. Von Einzelzellen bis Hochvoltsysteme.";

const services = [
  {
    id: "zellen",
    title: "Zelltransporte",
    subtitle: "UN3480 / UN3481",
    badge: "Basis",
    description: "Der sichere Transport von einzelnen Batteriezellen bildet das Fundament unserer Dienstleistungen. Ob zylindrische 18650-Zellen, Pouch-Zellen oder prismatische Zellen – wir gewährleisten ADR-konformen Transport in speziell zertifizierten Verpackungen.",
    useCases: [
      "Prototypentransporte für Forschung & Entwicklung",
      "Serienlieferungen für Produktionsstätten",
      "Ersatzteil-Logistik für After-Sales",
      "Transport defekter Zellen zur Entsorgung"
    ],
    specifications: [
      { label: "Zellchemien", value: "Li-Ion, Li-Polymer, Li-Metall" },
      { label: "UN-Nummern", value: "UN3480, UN3481, UN3090, UN3091" },
      { label: "Verpackung", value: "ADR 4G/4GV, spezialisierte Innenverpackung" },
      { label: "Temperaturen", value: "-20°C bis +60°C transportfähig" }
    ],
    features: [
      "Klassifizierung nach ADR-Batterie-Tabelle",
      "Entladungszustandskontrolle (SoC ≤ 30% für Air/Sea)",
      "Schockabsorbierende Verpackungssysteme",
      "Temperaturüberwachung während Transport",
      "Schadstoffkontrolle bei defekten Zellen"
    ]
  },
  {
    id: "module",
    title: "Modultransporte",
    subtitle: "Hochvolt-Module",
    badge: "Premium",
    description: "Batteriemodule aus der Automobil- und stationären Energiespeicherindustrie erfordern höchste Präzision. Wir transportieren Module von wenigen Volt bis hin zu 800V-Systemen mit spezialisiertem Equipment und geschultem Personal.",
    useCases: [
      "Automotive-Module für OEM-Produktion",
      "ESS-Module für Energiespeicherprojekte",
      "Austauschmodul-Logistik für Servicepartner",
      "Transport beschädigter Module (Schadensfall)"
    ],
    specifications: [
      { label: "Spannungsbereich", value: "12V - 800V DC" },
      { label: "Kapazität", value: "bis 500 kWh pro Transporteinheit" },
      { label: "Gewicht", value: "bis 2.000 kg pro Modul" },
      { label: "Schutzklasse", value: "IP54 - IP67 kompatibel" }
    ],
    features: [
      "Hochvoltsicherheits-Training (LV3) für Fahrer",
      "Isolierte Ladeflächen mit Schutzklassen",
      "Befestigungssysteme für Module bis 2t",
      "Elektrolyt-Leckage-Kontrolle",
      "Kühlung aktiver Module während Transport"
    ]
  },
  {
    id: "batterien",
    title: "Batterietransporte",
    subtitle: "Fertige Batteriesysteme",
    badge: "Enterprise",
    description: "Komplettes Hochvoltsysteme für E-Fahrzeuge, Busse, LKW oder industrielle ESS-Anlagen erfordern maximale Sorgfalt. Wir bieten End-to-End-Logistik für komplexe Batteriesysteme inklusive Anschlussdokumentation und Inbetriebnahme-Support.",
    useCases: [
      "E-Mobility: Pkw-, Bus-, LKW-Batteriesysteme",
      "Stationärer Speicher: Container-ESS, Rack-Systeme",
      "Marine: Boots- und Schiffsbatteriesysteme",
      "Luftfahrt: GSE (Ground Support Equipment)"
    ],
    specifications: [
      { label: "Systemspannung", value: "48V - 1.500V DC" },
      { label: "Energieinhalt", value: "bis 5 MWh pro Transport" },
      { label: "Gesamtgewicht", value: "bis 24t (gesamtes Fahrzeug)" },
      { label: "Transportart", value: "Solo, Sammelgut, Express" }
    ],
    features: [
      "Projektmanagement für Großtransporte",
      "Befestigungsplanung und Ladungssicherung",
      "24/7 Echtzeit-Tracking und Überwachung",
      "BMS-Statusüberwachung während Transport",
      "Koordination mit Zoll und Behörden",
      "Entsorgungsnachweis bei End-of-Life"
    ]
  }
];

const processSteps = [
  {
    number: "1",
    title: "Anfrage & Beratung",
    description: "Sie kontaktieren uns mit Ihren Anforderungen – Batterietyp, Menge, Herkunft, Ziel, Zeitrahmen. Unser Team klärt technische Details und gibt erste Empfehlungen zur Transportart.",
    details: ["Telefonische oder schriftliche Anfrage", "Erste Risikobewertung", "Transportvorschlag", "Kostenvoranschlag"]
  },
  {
    number: "2",
    title: "Sicherheitsprüfung",
    description: "Jeder Transport durchläuft unsere standardisierte Sicherheitsprüfung. Wir klassifizieren nach ADR, bestimmen die richtige Verpackung und dokumentieren alle relevanten Parameter.",
    details: ["ADR-Klassifizierung", "Verpackungsvorschrift (P903, P910 etc.)", "Gefahrgutpapiere erstellen", "Sondergenehmigungen prüfen"]
  },
  {
    number: "3",
    title: "Abholung & Verpackung",
    description: "Unsere zertifizierten Fahrer holen Ihre Ware ab. Bei Bedarf verpacken wir vor Ort nach ADR-Vorschrift oder übernehmen bereits verpackte Sendungen nach Sichtprüfung.",
    details: ["Terminabstimmung", "Zustandskontrolle", "Verpackung/Sicherung", "Übergabeprotokoll"]
  },
  {
    number: "4",
    title: "Transport & Überwachung",
    description: "Während des Transports überwachen wir Temperatur, Lage und ggf. Spannungszustand. Unsere Disposition ist rund um die Uhr erreichbar und trackt die Sendung in Echtzeit.",
    details: ["GPS-Tracking", "Temperaturüberwachung", "Dispositionskontakt 24/7", "Status-Updates"]
  },
  {
    number: "5",
    title: "Zustellung & Dokumentation",
    description: "Am Zielort erfolgt die sichere Übergabe an den Empfänger. Wir erstellen die finale Transportdokumentation für Ihre Unterlagen und den Nachweis der rechtskonformen Zustellung.",
    details: ["Empfangsbestätigung", "Zustandsprotokoll", "Gefahrgutpapier-Rücklauf", "Digitale Archivierung"]
  }
];

const certifications = [
  { name: "ADR 1.3", description: "Gefahrgutbeauftragter" },
  { name: "ADR 8.2", description: "Sicherheitsberater" },
  { name: "ISO 9001", description: "Qualitätsmanagement" },
  { name: "AEO", description: "Zertifizierter Wirtschaftsbeteiligter" }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  
  <main id="main-content">
    <!-- Hero Section -->
    <section 
      class="relative pt-32 pb-16 lg:pt-40 lg:pb-24 bg-dark-900"
      aria-labelledby="services-hero-heading"
    >
      <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-brand/5 to-transparent"></div>
      </div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl">
          <nav aria-label="Breadcrumb" class="mb-6">
            <ol class="flex items-center gap-2 text-sm">
              <li><a href="/" class="text-gray-400 hover:text-white transition-colors">Start</a></li>
              <li class="text-gray-600" aria-hidden="true">/</li>
              <li class="text-brand">Leistungen</li>
            </ol>
          </nav>
          
          <h1 id="services-hero-heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
            Unsere <span class="text-brand">Leistungen</span>
          </h1>
          
          <p class="text-lg sm:text-xl text-gray-300 leading-relaxed">
            Von der Einzelzelle bis zum komplexen Hochvoltsystem – wir bieten maßgeschneiderte 
            Transportlösungen für die gesamte Bandbreite der Batterieindustrie. 
            ADR-konform, zertifiziert und europaweit.
          </p>
        </div>
      </div>
    </section>
    
    <!-- Services Detail Section -->
    <section aria-label="Detaillierte Servicebeschreibungen">
      {services.map((service, index) => (
        <article 
          id={service.id}
          class={`py-16 lg:py-24 ${index % 2 === 0 ? 'bg-dark-800' : 'bg-dark-900'}`}
          aria-labelledby={`${service.id}-heading`}
        >
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class={`grid lg:grid-cols-2 gap-12 lg:gap-16 items-start ${index % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
              <!-- Content -->
              <div class={index % 2 === 1 ? 'lg:order-2' : ''}>
                <div class="flex items-center gap-3 mb-4">
                  <span class="bg-brand/10 text-brand text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-brand/20">
                    {service.badge}
                  </span>
                  <span class="text-gray-500 text-sm">{service.subtitle}</span>
                </div>
                
                <h2 id={`${service.id}-heading`} class="text-3xl sm:text-4xl font-bold text-white mb-6">
                  {service.title}
                </h2>
                
                <p class="text-gray-300 text-lg leading-relaxed mb-8">
                  {service.description}
                </p>
                
                <!-- Use Cases -->
                <div class="mb-8">
                  <h3 class="text-white font-semibold mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    Typische Einsatzbereiche
                  </h3>
                  <ul class="space-y-2" role="list">
                    {service.useCases.map(useCase => (
                      <li class="flex items-start gap-3 text-gray-400">
                        <span class="w-1.5 h-1.5 bg-brand rounded-full mt-2 shrink-0" aria-hidden="true"></span>
                        <span>{useCase}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                
                <!-- Specifications -->
                <div class="bg-dark-700/50 rounded-xl p-6 border border-dark-700 mb-8">
                  <h3 class="text-white font-semibold mb-4">Technische Spezifikationen</h3>
                  <dl class="grid grid-cols-2 gap-4">
                    {service.specifications.map(spec => (
                      <div>
                        <dt class="text-gray-500 text-xs uppercase tracking-wider mb-1">{spec.label}</dt>
                        <dd class="text-white font-medium text-sm">{spec.value}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
                
                <!-- Features -->
                <div>
                  <h3 class="text-white font-semibold mb-4">Inklusive Services</h3>
                  <ul class="grid sm:grid-cols-2 gap-3" role="list">
                    {service.features.map(feature => (
                      <li class="flex items-center gap-2 text-sm text-gray-300">
                        <svg class="w-4 h-4 text-brand shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        {feature}
                      </li>
                    ))}
                  </ul>
                </div>
                
                <div class="mt-8">
                  <a 
                    href="/contact"
                    class="inline-flex items-center gap-2 bg-brand hover:bg-brand-dark text-dark-900 font-semibold px-6 py-3 rounded-lg transition-colors"
                  >
                    Angebot anfordern
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </a>
                </div>
              </div>
              
              <!-- Image -->
              <div class={index % 2 === 1 ? 'lg:order-1' : ''}>
                <img 
                  src={`/images/leistung${index + 1}.png`}
                  alt={`${service.title} - ${service.subtitle} | CellMove Logistics`}
                  class="rounded-2xl shadow-2xl w-full aspect-[4/3] object-cover"
                  loading="lazy"
                  width="800"
                  height="600"
                />
              </div>
            </div>
          </div>
        </article>
      ))}
    </section>
    
    <!-- Process Section -->
    <section 
      class="py-20 lg:py-28 bg-dark-900"
      aria-labelledby="process-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-brand font-semibold text-sm uppercase tracking-wider">Unser Prozess</span>
          <h2 id="process-heading" class="text-3xl sm:text-4xl font-bold text-white mt-3 mb-4">
            Schritt für Schritt zum sicheren Transport
          </h2>
          <p class="text-gray-400 text-lg">
            Unser bewährter 5-Schritte-Prozess garantiert maximale Sicherheit und Compliance 
            bei jedem Transport – von der ersten Anfrage bis zur finalen Zustellung.
          </p>
        </div>
        
        <div class="space-y-8">
          {processSteps.map((step, index) => (
            <div class="relative">
              <!-- Connector line -->
              {index < processSteps.length - 1 && (
                <div class="hidden lg:block absolute left-8 top-16 w-0.5 h-8 bg-brand/30" aria-hidden="true"></div>
              )}
              
              <div class="bg-dark-800 rounded-2xl p-6 lg:p-8 border border-dark-700 hover:border-brand/20 transition-colors">
                <div class="flex flex-col lg:flex-row lg:items-start gap-6">
                  <!-- Step number -->
                  <div class="w-16 h-16 bg-brand rounded-xl flex items-center justify-center shrink-0">
                    <span class="text-2xl font-bold text-dark-900">{step.number}</span>
                  </div>
                  
                  <!-- Content -->
                  <div class="flex-1">
                    <h3 class="text-xl font-bold text-white mb-3">{step.title}</h3>
                    <p class="text-gray-400 mb-4 leading-relaxed">{step.description}</p>
                    
                    <!-- Details -->
                    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
                      {step.details.map(detail => (
                        <div class="flex items-center gap-2 text-sm text-gray-300">
                          <svg class="w-4 h-4 text-brand shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                          </svg>
                          {detail}
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Certifications Section -->
    <section 
      class="py-16 lg:py-20 bg-dark-800"
      aria-labelledby="cert-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="cert-heading" class="text-center text-2xl font-bold text-white mb-12">
          Zertifizierungen & Compliance
        </h2>
        
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
          {certifications.map(cert => (
            <div class="bg-dark-700/50 rounded-xl p-6 text-center border border-dark-700">
              <div class="w-12 h-12 bg-brand/10 rounded-lg flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                </svg>
              </div>
              <h3 class="text-white font-semibold">{cert.name}</h3>
              <p class="text-gray-400 text-sm mt-1">{cert.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- FAQ / Additional Info -->
    <section 
      class="py-16 lg:py-20 bg-dark-900"
      aria-labelledby="faq-heading"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-white text-center mb-12">
          Häufige Fragen zu unseren Transporten
        </h2>
        
        <div class="space-y-4">
          <details class="bg-dark-800 rounded-xl border border-dark-700 group">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <span class="text-white font-medium">Welche Dokumente werden für einen Transport benötigt?</span>
              <span class="text-brand transition-transform group-open:rotate-180">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-400">
              Je nach Transportart benötigen wir: Sicherheitsdatenblatt (SDS), UN-Testzertifikat (38.3), Gefahrgutklassifikation, Entladungsnachweis (für defekte Zellen) sowie Handelsrechnung bei grenzüberschreitenden Transporten. Wir unterstützen Sie bei der Beschaffung und Prüfung aller Dokumente.
            </div>
          </details>
          
          <details class="bg-dark-800 rounded-xl border border-dark-700 group">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <span class="text-white font-medium">Wie schnell kann ein Transport realisiert werden?</span>
              <span class="text-brand transition-transform group-open:rotate-180">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-400">
              Standardtransporte können innerhalb von 24-48 Stunden nach Dokumentenprüfung realisiert werden. Für Express-Transporte (Same-Day, Next-Day) kontaktieren Sie uns bitte direkt telefonisch unter 01556 0114442. Defekte oder beschädigte Batterien erfordern in der Regel längere Vorlaufzeiten aufgrund zusätzlicher Sicherheitsprüfungen.
            </div>
          </details>
          
          <details class="bg-dark-800 rounded-xl border border-dark-700 group">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <span class="text-white font-medium">Transportieren Sie auch defekte oder beschädigte Batterien?</span>
              <span class="text-brand transition-transform group-open:rotate-180">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-400">
              Ja, wir transportieren auch beschädigte oder defekte Lithium-Batterien (P908/P910/P911). Diese Transporte unterliegen jedoch strengeren Auflagen: Erhöhte Verpackungsanforderungen, spezielle Fahrzeugausstattung und bei Schadensfall möglicherweise behördliche Genehmigungen. Kontaktieren Sie uns frühzeitig für eine individuelle Beratung.
            </div>
          </details>
          
          <details class="bg-dark-800 rounded-xl border border-dark-700 group">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <span class="text-white font-medium">In welche Länder transportieren Sie?</span>
              <span class="text-brand transition-transform group-open:rotate-180">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-400">
              Wir bieten Transporte in alle EU-Mitgliedstaaten sowie in die Schweiz, Norwegen und weitere europäische Länder. Für Länder außerhalb des europäischen Wirtschaftsraums (z.B. UK, Türkei) berücksichtigen wir zusätzliche Zoll- und Importbestimmungen.
            </div>
          </details>
        </div>
      </div>
    </section>
    
    <!-- CTA Section -->
    <section 
      class="py-16 lg:py-20 bg-brand"
      aria-labelledby="services-cta-heading"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 id="services-cta-heading" class="text-3xl sm:text-4xl font-bold text-dark-900 mb-4">
          Bereit für Ihren Transport?
        </h2>
        <p class="text-dark-800 text-lg mb-8">
      Beschreiben Sie uns Ihr Projekt – wir erstellen Ihnen ein unverbindliches Angebot.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/contact"
            class="inline-flex items-center justify-center gap-2 bg-dark-900 hover:bg-dark-800 text-white font-semibold px-8 py-4 rounded-lg transition-colors"
          >
            Jetzt anfragen
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a 
            href="tel:+4915560114442"
            class="inline-flex items-center justify-center gap-2 bg-white/20 hover:bg-white/30 text-dark-900 font-semibold px-8 py-4 rounded-lg transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            01556 0114442
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
  <CookieBanner />
</Layout>
