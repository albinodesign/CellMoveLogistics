---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

const pageTitle = "Kontakt | CellMove Logistics - Transportanfrage";
const pageDescription = "Kontaktieren Sie CellMove Logistics für Ihren Batterietransport. Anfragen unter +49 155 60 11 44 42 oder per Formular. ADR-konforme Gefahrguttransporte europaweit.";

const contactInfo = {
  company: "CellMove Logistics GmbH",
  owner: "Christian Gördes",
  address: {
    street: "Peter-Rosegger-Str. 4",
    city: "72762 Reutlingen",
    country: "Deutschland"
  },
  phone: "+49 155 60 11 44 42",
  email: "contact@cellmove-logistics.com",
  hours: {
    weekday: "08:00 - 18:00 Uhr",
    saturday: "09:00 - 14:00 Uhr",
    sunday: "Geschlossen"
  }
};

const formFields = {
  salutation: ["Herr", "Frau", "Divers", "Firma"],
  transportType: [
    { value: "", label: "Bitte wählen" },
    { value: "zellen", label: "Zelltransport (UN3480/3481)" },
    { value: "module", label: "Modultransport (Hochvolt)" },
    { value: "batterien", label: "Batteriesysteme" },
    { value: "sonstiges", label: "Sonstiges / Unsicher" }
  ]
};

// Web3Forms-Key kommt aus der Build-Umgebung (Vercel: PUBLIC_WEB3FORMS_KEY),
// damit der Key nicht im Repository liegt. Siehe AGENTS.md.
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

if (!web3FormsKey) {
  console.warn(
    '[contact.astro] PUBLIC_WEB3FORMS_KEY ist nicht gesetzt - das Kontaktformular ' +
    'wird mit dem Platzhalter ausgeliefert und funktioniert nicht. Key kostenlos unter ' +
    'https://web3forms.com/ holen und in den Vercel-Projekt-Einstellungen als ' +
    'Environment Variable (PUBLIC_WEB3FORMS_KEY) hinterlegen.'
  );
}
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  
  <main id="main-content">
    <!-- Hero Section -->
    <section 
      class="relative pt-32 pb-12 lg:pt-40 lg:pb-16 bg-dark-900"
      aria-labelledby="contact-hero-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex items-center gap-2 text-sm">
            <li><a href="/" class="text-gray-400 hover:text-white transition-colors">Start</a></li>
            <li class="text-gray-600" aria-hidden="true">/</li>
            <li class="text-brand">Kontakt</li>
          </ol>
        </nav>
        
        <h1 id="contact-hero-heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4">
          Kontaktieren Sie <span class="text-brand">uns</span>
        </h1>
        <p class="text-lg sm:text-xl text-gray-300 max-w-3xl">
          Haben Sie Fragen zu einem Transport oder möchten ein Angebot einholen? 
          Wir sind für Sie da – telefonisch, per E-Mail oder über das Kontaktformular.
        </p>
      </div>
    </section>
    
    <!-- Contact Section -->
    <section 
      class="py-12 lg:py-20 bg-dark-900"
      aria-labelledby="contact-form-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">
          
          <!-- Contact Form (Left - 3 cols) -->
          <div class="lg:col-span-3">
            <div class="bg-dark-800 rounded-2xl p-6 sm:p-8 lg:p-10 border border-dark-700">
              <h2 id="contact-form-heading" class="text-2xl font-bold text-white mb-2">
                Transportanfrage
              </h2>
              <p class="text-gray-400 mb-8">
                Füllen Sie das Formular aus – wir melden uns innerhalb von 24 Stunden bei Ihnen.
              </p>
              
              <form 
                id="contact-form"
                action="https://api.web3forms.com/submit"
                method="POST"
                class="space-y-6"
                aria-label="Kontaktformular"
              >
                <!-- Web3Forms Access Key - kommt aus PUBLIC_WEB3FORMS_KEY (siehe AGENTS.md) -->
                <input type="hidden" name="access_key" value={web3FormsKey ?? ''} />
                
                <!-- Honeypot Spam Protection -->
                <input 
                  type="checkbox" 
                  name="botcheck" 
                  class="hidden" 
                  style="display: none;" 
                  tabindex="-1" 
                  autocomplete="off"
                  aria-hidden="true"
                />
                
                <!-- Subject -->
                <input type="hidden" name="subject" value="Neue Transportanfrage - CellMove Logistics" />
                
                <!-- From Name -->
                <input type="hidden" name="from_name" value="CellMove Logistics Website" />
                
                <!-- Redirect URL (optional) -->
                <input type="hidden" name="redirect" value="https://cellmove-logistics.com/contact?success=true" />
                
                <!-- Salutation & Name Row -->
                <div class="grid sm:grid-cols-4 gap-4">
                  <div class="sm:col-span-1">
                    <label for="salutation" class="block text-sm font-medium text-gray-300 mb-2">
                      Anrede <span class="text-gray-500">(optional)</span>
                    </label>
                    <select 
                      id="salutation"
                      name="salutation"
                      class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                    >
                      {formFields.salutation.map(option => (
                        <option value={option}>{option}</option>
                      ))}
                    </select>
                  </div>
                  
                  <div class="sm:col-span-3">
                    <label for="name" class="block text-sm font-medium text-gray-300 mb-2">
                      Name <span class="text-brand">*</span>
                    </label>
                    <input 
                      type="text"
                      id="name"
                      name="name"
                      required
                      class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                      placeholder="Max Mustermann"
                    />
                  </div>
                </div>
                
                <!-- Company -->
                <div>
                  <label for="company" class="block text-sm font-medium text-gray-300 mb-2">
                    Firma <span class="text-gray-500">(optional)</span>
                  </label>
                  <input 
                    type="text"
                    id="company"
                    name="company"
                    class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                    placeholder="Muster GmbH"
                  />
                </div>
                
                <!-- Email & Phone Row -->
                <div class="grid sm:grid-cols-2 gap-4">
                  <div>
                    <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
                      E-Mail <span class="text-brand">*</span>
                    </label>
                    <input 
                      type="email"
                      id="email"
                      name="email"
                      required
                      class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                      placeholder="max@beispiel.de"
                    />
                  </div>
                  
                  <div>
                    <label for="phone" class="block text-sm font-medium text-gray-300 mb-2">
                      Telefon <span class="text-brand">*</span>
                    </label>
                    <input 
                      type="tel"
                      id="phone"
                      name="phone"
                      required
                      class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                      placeholder="+49 123 456789"
                    />
                  </div>
                </div>
                
                <!-- Transport Type -->
                <div>
                  <label for="transport_type" class="block text-sm font-medium text-gray-300 mb-2">
                    Art des Transports <span class="text-brand">*</span>
                  </label>
                  <select 
                    id="transport_type"
                    name="transport_type"
                    required
                    class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                  >
                    {formFields.transportType.map(option => (
                      <option value={option.value}>{option.label}</option>
                    ))}
                  </select>
                </div>
                
                <!-- Weight -->
                <div>
                  <label for="weight" class="block text-sm font-medium text-gray-300 mb-2">
                    Geschätztes Gewicht der Ladung (kg) <span class="text-gray-500">(optional)</span>
                  </label>
                  <input 
                    type="number"
                    id="weight"
                    name="weight"
                    class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                    placeholder="z.B. 500"
                    min="0"
                  />
                </div>
                
                <!-- Abholadresse -->
                <div class="border-t border-dark-700 pt-6">
                  <h3 class="text-white font-semibold mb-4">Abholadresse</h3>
                  <div class="space-y-4">
                    <div class="grid sm:grid-cols-2 gap-4">
                      <div>
                        <label for="pickup_street" class="block text-sm font-medium text-gray-300 mb-2">
                          Straße <span class="text-brand">*</span>
                        </label>
                        <input 
                          type="text"
                          id="pickup_street"
                          name="pickup_street"
                          required
                          class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                          placeholder="Musterstraße"
                        />
                      </div>
                      <div>
                        <label for="pickup_company" class="block text-sm font-medium text-gray-300 mb-2">
                          Firma <span class="text-gray-500">(optional)</span>
                        </label>
                        <input 
                          type="text"
                          id="pickup_company"
                          name="pickup_company"
                          class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                          placeholder="Muster GmbH"
                        />
                      </div>
                    </div>
                    <div class="grid sm:grid-cols-2 gap-4">
                      <div>
                        <label for="pickup_number" class="block text-sm font-medium text-gray-300 mb-2">
                          Hausnummer <span class="text-brand">*</span>
                        </label>
                        <input 
                          type="text"
                          id="pickup_number"
                          name="pickup_number"
                          required
                          class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                          placeholder="1"
                        />
                      </div>
                      <div>
                        <label for="pickup_zip" class="block text-sm font-medium text-gray-300 mb-2">
                          PLZ <span class="text-brand">*</span>
                        </label>
                        <input 
                          type="text"
                          id="pickup_zip"
                          name="pickup_zip"
                          required
                          class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                          placeholder="12345"
                        />
                      </div>
                    </div>
                    <div class="grid sm:grid-cols-2 gap-4">
                      <div>
                        <label for="pickup_contact_email" class="block text-sm font-medium text-gray-300 mb-2">
                          Email Ansprechpartner <span class="text-gray-500">(optional)</span>
                        </label>
                        <input 
                          type="email"
                          id="pickup_contact_email"
                          name="pickup_contact_email"
                          class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                          placeholder="kontakt@firma.de"
                        />
                      </div>
                      <div>
                        <label for="pickup_contact_phone" class="block text-sm font-medium text-gray-300 mb-2">
                          Telefon Ansprechpartner <span class="text-gray-500">(optional)</span>
                        </label>
                        <input 
                          type="tel"
                          id="pickup_contact_phone"
                          name="pickup_contact_phone"
                          class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                          placeholder="+49 123 456789"
                        />
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Zieladresse / Abladestelle -->
                <div class="border-t border-dark-700 pt-6">
                  <h3 class="text-white font-semibold mb-4">Zieladresse / Abladestelle</h3>
                  <div class="space-y-4">
                    <div class="grid sm:grid-cols-2 gap-4">
                      <div>
                        <label for="delivery_street" class="block text-sm font-medium text-gray-300 mb-2">
                          Straße <span class="text-brand">*</span>
                        </label>
                        <input 
                          type="text"
                          id="delivery_street"
                          name="delivery_street"
                          required
                          class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                          placeholder="Zielstraße"
                        />
                      </div>
                      <div>
                        <label for="delivery_company" class="block text-sm font-medium text-gray-300 mb-2">
                          Firma <span class="text-gray-500">(optional)</span>
                        </label>
                        <input 
                          type="text"
                          id="delivery_company"
                          name="delivery_company"
                          class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
                          placeholder="Ziel GmbH"
                        />
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Message -->
                <div>
                  <label for="message" class="block text-sm font-medium text-gray-300 mb-2">
                    Ihre Nachricht / Details zum Transport <span class="text-brand">*</span>
                  </label>
                  <textarea 
                    id="message"
                    name="message"
                    rows="5"
                    required
                    class="w-full bg-dark-700 border border-dark-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:ring-1 focus:ring-brand transition-colors resize-y"
                    placeholder="Beschreiben Sie kurz: Was soll transportiert werden? (Zellen/Module/Batterien, Menge, ungefähres Gewicht, Zeitrahmen, besondere Anforderungen...)"
                  ></textarea>
                </div>
                
                <!-- Privacy Checkbox -->
                <div class="flex items-start gap-3">
                  <input 
                    type="checkbox"
                    id="privacy"
                    name="privacy"
                    required
                    class="w-5 h-5 mt-0.5 bg-dark-700 border-dark-600 rounded text-brand focus:ring-brand focus:ring-offset-dark-800"
                  />
                  <label for="privacy" class="text-sm text-gray-400">
                    Ich habe die <a href="/legal#datenschutz" class="text-brand hover:underline">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten gemäß DSGVO zu. <span class="text-brand">*</span>
                  </label>
                </div>
                
                <!-- Submit Button -->
                <button 
                  type="submit"
                  id="submit-btn"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-brand hover:bg-brand-dark text-dark-900 font-semibold px-8 py-4 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span>Anfrage senden</span>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                  </svg>
                </button>
                
                <!-- Status Messages -->
                <div id="form-status" class="hidden" role="status" aria-live="polite">
                  <div id="success-message" class="hidden bg-green-500/10 border border-green-500/20 rounded-lg p-4 text-green-400">
                    <div class="flex items-center gap-3">
                      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <div>
                        <p class="font-medium">Vielen Dank für Ihre Anfrage!</p>
                        <p class="text-sm mt-1">Wir haben Ihre Nachricht erhalten und melden uns innerhalb von 24 Stunden bei Ihnen.</p>
                      </div>
                    </div>
                  </div>
                  
                  <div id="error-message" class="hidden bg-red-500/10 border border-red-500/20 rounded-lg p-4 text-red-400">
                    <div class="flex items-center gap-3">
                      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <div>
                        <p class="font-medium">Ein Fehler ist aufgetreten.</p>
                        <p class="text-sm mt-1">Bitte versuchen Sie es später erneut oder kontaktieren Sie uns telefonisch.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </form>
            </div>
          </div>
          
          <!-- Contact Info Card (Right - 2 cols) -->
          <div class="lg:col-span-2">
            <div class="sticky top-24 space-y-6">
              <!-- Main Contact Card -->
              <div class="bg-dark-800 rounded-2xl p-6 sm:p-8 border border-dark-700">
                <h2 class="text-xl font-bold text-white mb-6">Direkter Kontakt</h2>
                
                <div class="space-y-6">
                  <!-- Phone -->
                  <a 
                    href={`tel:+49${contactInfo.phone.replace(/^0/, '').replace(/\s/g, '')}`}
                    class="flex items-start gap-4 group"
                  >
                    <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-brand/20 transition-colors">
                      <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                      </svg>
                    </div>
                    <div>
                      <p class="text-gray-400 text-sm">Telefon</p>
                      <p class="text-white font-semibold group-hover:text-brand transition-colors">{contactInfo.phone}</p>
                      <p class="text-brand text-xs mt-1">Sofort erreichbar</p>
                    </div>
                  </a>
                  
                  <!-- Email -->
                  <a 
                    href={`mailto:${contactInfo.email}`}
                    class="flex items-start gap-4 group"
                  >
                    <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-brand/20 transition-colors">
                      <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                      </svg>
                    </div>
                    <div>
                      <p class="text-gray-400 text-sm">E-Mail</p>
                      <p class="text-white font-semibold group-hover:text-brand transition-colors">{contactInfo.email}</p>
                      <p class="text-gray-500 text-xs mt-1">Antwort innerhalb 24h</p>
                    </div>
                  </a>
                  
                  <!-- Address -->
                  <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center shrink-0">
                      <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                    </div>
                    <div>
                      <p class="text-gray-400 text-sm">Adresse</p>
                      <address class="not-italic">
                        <p class="text-white font-semibold">{contactInfo.company}</p>
                        <p class="text-gray-300">{contactInfo.address.street}</p>
                        <p class="text-gray-300">{contactInfo.address.city}</p>
                        <p class="text-gray-300">{contactInfo.address.country}</p>
                      </address>
                    </div>
                  </div>
                  
                  <!-- Hours -->
                  <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-brand/10 rounded-xl flex items-center justify-center shrink-0">
                      <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    </div>
                    <div>
                      <p class="text-gray-400 text-sm">Öffnungszeiten</p>
                      <ul class="space-y-1 mt-1">
                        <li class="flex justify-between text-sm">
                          <span class="text-gray-300">Mo - Fr:</span>
                          <span class="text-white">{contactInfo.hours.weekday}</span>
                        </li>
                        <li class="flex justify-between text-sm">
                          <span class="text-gray-300">Sa:</span>
                          <span class="text-white">{contactInfo.hours.saturday}</span>
                        </li>
                        <li class="flex justify-between text-sm">
                          <span class="text-gray-300">So:</span>
                          <span class="text-gray-500">{contactInfo.hours.sunday}</span>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- Quick Response Card -->
              <div class="bg-brand/10 border border-brand/20 rounded-2xl p-6">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-brand rounded-lg flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5 text-dark-900" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-white font-semibold mb-1">Schnelle Reaktion</h3>
                    <p class="text-gray-400 text-sm">
                      Für dringende Transportanfragen erreichen Sie uns auch außerhalb der Geschäftszeiten unter der Mobilnummer.
                    </p>
                  </div>
                </div>
              </div>
              

            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
  <CookieBanner />
  
  <script>
    // Form handling
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const formStatus = document.getElementById('form-status');
    const successMessage = document.getElementById('success-message');
    const errorMessage = document.getElementById('error-message');
    
    // Check for success parameter in URL (from redirect)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('success') === 'true') {
      formStatus?.classList.remove('hidden');
      successMessage?.classList.remove('hidden');
      form?.reset();
      // Clean URL
      window.history.replaceState({}, document.title, window.location.pathname);
    }
    
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Disable submit button
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Wird gesendet...</span>
        `;
      }
      
      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData
        });
        
        if (response.ok) {
          formStatus?.classList.remove('hidden');
          successMessage?.classList.remove('hidden');
          errorMessage?.classList.add('hidden');
          form.reset();
          
          // Scroll to success message
          successMessage?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error('Form submission failed');
        }
      } catch (error) {
        formStatus?.classList.remove('hidden');
        errorMessage?.classList.remove('hidden');
        successMessage?.classList.add('hidden');
      } finally {
        // Re-enable submit button
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `
            <span>Anfrage senden</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
          `;
        }
      }
    });
  </script>
</Layout>
