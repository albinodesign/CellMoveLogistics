---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';

const pageTitle = "CellMove Logistics | Sichere Batterietransporte europaweit";
const pageDescription = "CellMove Logistics GmbH - Ihr Spezialist für ADR-konforme Transporte von Lithium-Ionen Batterien, Zellen und Modulen. UN3480/UN3481 zertifiziert. Europaweite Logistik aus Reutlingen.";

const trustItems = [
  {
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    title: "ADR-konform",
    description: "Vollständige Einhaltung aller Gefahrgutvorschriften"
  },
  {
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
    title: "UN3480/3481",
    description: "Zertifiziert für alle Lithium-Batterieklassen"
  },
  {
    icon: "M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064",
    title: "Europaweit",
    description: "Transporte zwischen allen EU-Ländern"
  },
  {
    icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    title: "EU-Ausland",
    description: "Transporte aus dem EU-Ausland / Abholungen aus dem EU-Ausland. Bitte per Mail anfragen."
  }
];

const services = [
  {
    title: "Zelltransporte",
    subtitle: "UN3480 / UN3481",
    description: "Sicherer Transport von Einzelzellen und Zellstapeln. Spezielle Verpackung nach ADR-Vorschrift für alle Lithium-Metall- und Lithium-Ionen-Zellen.",
    features: ["ADR-konforme Verpackung", "Temperaturüberwachung", "Entladungskontrolle"],
    href: "/services#zellen"
  },
  {
    title: "Modultransporte",
    subtitle: "Hochvolt-Module",
    description: "Spezialtransporte für Batteriemodule aus der Automobil- und Energiespeicherindustrie. Sichere Handhabung auch bei defekten Modulen.",
    features: ["Hochvoltsicherheit", "Schadstoffkontrolle", "Gekühlter Transport", "Beratung bei Verpackung"],
    href: "/services#module"
  },
  {
    title: "Batterietransporte",
    subtitle: "Fertige Batteriesysteme",
    description: "Komplettlösungen für den Transport fertiger Hochvoltbatterien und Energiespeichersysteme bis 1.000V und mehr.",
    features: ["Bis 1.000V+ zertifiziert", "Live-Überwachung", "24/7 Support"],
    href: "/services#batterien"
  }
];

const processSteps = [
  {
    step: "01",
    title: "Anfrage",
    description: "Teilen Sie uns Ihre Transportanforderungen mit – Batterietyp, Menge, Zielort und Zeitrahmen."
  },
  {
    step: "02",
    title: "Sicherheitsprüfung",
    description: "Wir prüfen die Anfrage und kommen für eventuelle Rückfragen auf Sie zu. Wir kümmern uns um die Dokumentation. ADR-Klassifizierung"
  },
  {
    step: "03",
    title: "Abholung",
    description: "Unsere zertifizierten Fahrer holen Ihre Ware mit spezialisiertem Equipment ab."
  },
  {
    step: "04",
    title: "Transport",
    description: "Gefahrguttransport mit engem Tracking. GPS-überwachter Transport mit Echtzeit-Tracking und rund um die Uhr Disposition."
  },
  {
    step: "05",
    title: "Zustellung",
    description: "Sichere Übergabe am Zielort mit vollständiger Dokumentation für Ihre Akten."
  }
];

const features = [
  {
    title: "Höchste Sicherheitsstandards",
    description: "Alle Transporte erfolgen nach aktuellsten ADR- und UN-Vorschriften. Unsere Fahrer sind speziell geschult für den Umgang mit Gefahrgut."
  },
  {
    title: "Branchenexpertise",
    description: "Langjährige Erfahrung in der Batterielogistik für Automotive, Energy Storage und Elektronikhersteller."
  },
  {
    title: "Flexible Lösungen",
    description: "Von Einzeltransporten bis zur regelmäßigen Tourenplanung – wir passen uns Ihren Anforderungen an."
  },
  {
    title: "Dokumentation",
    description: "Vollständige Transportdokumentation inkl. Gefahrgutpapieren, Zollunterlagen und digitalem Tracking."
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  
  <main id="main-content">
    <!-- Hero Section -->
    <section 
      class="relative min-h-screen flex items-center pt-20"
      aria-labelledby="hero-heading"
    >
      <!-- Background with gradient overlay -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/hero.png"
          alt="CellMove Logistics - Professioneller Gefahrguttransport für Lithium-Ionen Batterien"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          width="1920"
          height="1080"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-dark-900 via-dark-900/95 to-dark-900/70"></div>
      </div>
      
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
        <div class="max-w-3xl">

          
          <h1 id="hero-heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
            Sichere Batterietransporte
            <span class="text-brand">europaweit</span>
          </h1>
          
          <p class="text-lg sm:text-xl text-gray-300 mb-8 max-w-2xl leading-relaxed">
            Spezialisiert auf ADR-konforme Transporte von Lithium-Ionen Batterien, Zellen und Modulen. 
            UN3480/UN3481 zertifiziert.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a 
              href="/contact"
              class="inline-flex items-center justify-center gap-2 bg-brand hover:bg-brand-dark text-dark-900 font-semibold px-8 py-4 rounded-lg transition-colors text-center"
            >
              Transport anfragen
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a 
              href="/services"
              class="inline-flex items-center justify-center gap-2 border border-gray-600 hover:border-brand text-white hover:text-brand font-medium px-8 py-4 rounded-lg transition-colors text-center"
            >
              Leistungen entdecken
            </a>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Trust Bar -->
    <section 
      class="bg-dark-800 border-y border-dark-700 py-8"
      aria-label="Vertrauensindikatoren"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
          {trustItems.map(item => (
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-dark-700 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
                </svg>
              </div>
              <div>
                <h3 class="text-white font-semibold text-sm">{item.title}</h3>
                <p class="text-gray-400 text-xs mt-1">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Services Section -->
    <section 
      class="py-20 lg:py-28 bg-dark-900"
      aria-labelledby="services-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-brand font-semibold text-sm uppercase tracking-wider">Spezialisiert auf</span>
          <h2 id="services-heading" class="text-3xl sm:text-4xl font-bold text-white mt-3 mb-4">
            Gefahrguttransport für die Batterieindustrie
          </h2>
          <p class="text-gray-400 text-lg">
            Vom einzelnen Zellstapel bis zum komplexen Hochvoltsystem – 
            wir transportieren Ihre Batterien sicher und rechtskonform.
          </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          {services.map((service, index) => (
            <article class="bg-dark-800 rounded-2xl overflow-hidden border border-dark-700 hover:border-brand/30 transition-colors group">
              <div class="aspect-video relative overflow-hidden">
                <img 
                  src={`/images/leistung${index + 1}.png`}
                  alt={`${service.title} - ${service.subtitle} bei CellMove Logistics`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  width="600"
                  height="338"
                />
                <div class="absolute top-4 left-4 bg-brand text-dark-900 text-xs font-bold px-3 py-1 rounded-full">
                  {service.subtitle}
                </div>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold text-white mb-3">{service.title}</h3>
                <p class="text-gray-400 text-sm mb-4 leading-relaxed">{service.description}</p>
                <ul class="space-y-2 mb-6" role="list">
                  {service.features.map(feature => (
                    <li class="flex items-center gap-2 text-sm text-gray-300">
                      <svg class="w-4 h-4 text-brand shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>
                <a 
                  href={service.href}
                  class="inline-flex items-center gap-2 text-brand hover:text-brand-light font-medium text-sm group/link"
                  aria-label={`Mehr über ${service.title} erfahren`}
                >
                  Details ansehen
                  <svg class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Process Section -->
    <section 
      class="py-20 lg:py-28 bg-dark-800"
      aria-labelledby="process-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-brand font-semibold text-sm uppercase tracking-wider">So funktioniert's</span>
          <h2 id="process-heading" class="text-3xl sm:text-4xl font-bold text-white mt-3 mb-4">
            Unser 5-Schritte-Prozess
          </h2>
          <p class="text-gray-400 text-lg">
            Effizient, transparent und durchdacht – vom ersten Kontakt bis zur Zustellung.
          </p>
        </div>
        
        <div class="relative">
          <!-- Connection line (desktop) -->
          <div class="hidden lg:block absolute top-12 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-brand/30 to-transparent"></div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8">
            {processSteps.map((step) => (
              <div class="relative text-center">
                <div class="w-24 h-24 mx-auto bg-dark-700 rounded-full flex items-center justify-center border-4 border-dark-800 relative z-10 mb-4">
                  <span class="text-2xl font-bold text-brand">{step.step}</span>
                </div>
                <h3 class="text-white font-semibold mb-2">{step.title}</h3>
                <p class="text-gray-400 text-sm leading-relaxed">{step.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
    
    <!-- Why Us Section -->
    <section 
      class="py-20 lg:py-28 bg-dark-900"
      aria-labelledby="whyus-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div>
            <span class="text-brand font-semibold text-sm uppercase tracking-wider">Warum CellMove</span>
            <h2 id="whyus-heading" class="text-3xl sm:text-4xl font-bold text-white mt-3 mb-6">
              Ihr Partner für sichere Batterielogistik
            </h2>
            <p class="text-gray-400 text-lg mb-8 leading-relaxed">
              Gefahrguttransporte erfordern erhöhte Achtsamkeit und zusätzliche Qualifikation. Mit CellMove Logistics entscheiden Sie sich für einen Partner, der Sicherheit nicht nur verspricht, sondern systematisch umsetzt.
            </p>
            
            <div class="grid sm:grid-cols-2 gap-6">
              {features.map(feature => (
                <div class="bg-dark-800 p-5 rounded-xl border border-dark-700">
                  <h3 class="text-white font-semibold mb-2 flex items-center gap-2">
                    <svg class="w-5 h-5 text-brand shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    {feature.title}
                  </h3>
                  <p class="text-gray-400 text-sm leading-relaxed">{feature.description}</p>
                </div>
              ))}
            </div>
          </div>
          
          <div class="relative">
            <img 
              src="/images/uberuns.png"
              alt="CellMove Logistics Team bei der professionellen Lagerung und Verladung von Lithium-Ionen Batterien"
              class="rounded-2xl w-full h-auto object-cover aspect-[4/5]"
              loading="lazy"
              width="600"
              height="750"
            />

          </div>
        </div>
      </div>
    </section>
    
    <!-- CTA Section -->
    <section 
      class="py-20 lg:py-28 bg-brand relative overflow-hidden"
      aria-labelledby="cta-heading"
    >
      <!-- Decorative elements -->
      <div class="absolute top-0 left-0 w-64 h-64 bg-white/10 rounded-full -translate-x-1/2 -translate-y-1/2" aria-hidden="true"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-white/10 rounded-full translate-x-1/3 translate-y-1/3" aria-hidden="true"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-3xl mx-auto">
          <h2 id="cta-heading" class="text-3xl sm:text-4xl font-bold text-dark-900 mb-4">
            Bereit für Ihren nächsten Transport?
          </h2>
          <p class="text-dark-800 text-lg mb-8">
            Kontaktieren Sie uns jetzt für ein unverbindliches Angebot. 
            Wir beraten Sie gerne zu Ihren spezifischen Transportanforderungen.
          </p>
          <p class="text-dark-800/80 text-sm mb-8 font-medium">
            ADR-konform • UN3480/UN3481 zertifiziert • Gefahrguttransport nach EU-Richtlinien
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="/contact"
              class="inline-flex items-center justify-center gap-2 bg-dark-900 hover:bg-dark-800 text-white font-semibold px-8 py-4 rounded-lg transition-colors"
            >
              Anfrage starten
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a 
              href="tel:+4915560114442"
              class="inline-flex items-center justify-center gap-2 bg-white/20 hover:bg-white/30 text-dark-900 font-semibold px-8 py-4 rounded-lg transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              +49 155 60 11 44 42
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
  <CookieBanner />
</Layout>
